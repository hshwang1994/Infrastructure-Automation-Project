pipeline {
    agent { label "${params.loc} && ${params.target_type}" }

    parameters {
        string(name: 'loc',         defaultValue: '', description: 'Agent 위치 (ich | chj | yi)')
        string(name: 'target_type', defaultValue: '', description: '대상 종류 (linux | windows | esxi | redfish)')
        text(  name: 'inventory_json', defaultValue: '[]', description: '타겟 호스트 JSON 배열')
    }

    environment {
        INVENTORY_JSON = "${params.inventory_json}"
        TARGET_TYPE    = "${params.target_type}"
        REPO_ROOT      = "${WORKSPACE}"
    }

    stages {
        stage('Pre-check') {
            steps {
                ansiblePlaybook(
                    installation      : 'ansible',
                    playbook          : "${WORKSPACE}/playbook/redfish-fw-update/pre.yml",
                    vaultCredentialsId: 'ansible-vault-password',
                    colorized         : true
                )
            }
        }

        stage('Backup') {
            steps {
                ansiblePlaybook(
                    installation      : 'ansible',
                    playbook          : "${WORKSPACE}/playbook/redfish-fw-update/backup.yml",
                    vaultCredentialsId: 'ansible-vault-password',
                    colorized         : true
                )
            }
        }

        stage('Approve') {
            steps {
                input message: '펌웨어 업그레이드를 진행하시겠습니까? (Pre-check + Backup 통과)', ok: '진행'
            }
        }

        stage('Upgrade') {
            steps {
                ansiblePlaybook(
                    installation      : 'ansible',
                    playbook          : "${WORKSPACE}/playbook/redfish-fw-update/upgrade.yml",
                    vaultCredentialsId: 'ansible-vault-password',
                    colorized         : true
                )
            }
        }

        stage('Verify') {
            steps {
                ansiblePlaybook(
                    installation      : 'ansible',
                    playbook          : "${WORKSPACE}/playbook/redfish-fw-update/verify.yml",
                    vaultCredentialsId: 'ansible-vault-password',
                    colorized         : true
                )
            }
        }
    }
}
