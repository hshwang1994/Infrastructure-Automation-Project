def validateParameters(Map params) {
    if (!params.callbackUrl?.trim()) {
        error("callbackUrl 파라미터가 비어있습니다.")
    }
    parseHostNames(params.inventory_json)
}

def parseHostNames(String inventoryJson) {
    def parsed
    try {
        parsed = readJSON(text: inventoryJson ?: '[]')
    } catch (Exception e) {
        error("inventory_json 파싱 실패: ${e.message}")
    }

    if (!(parsed instanceof List)) {
        error("inventory_json 최상위는 배열이어야 합니다.")
    }
    if (parsed.isEmpty()) {
        error("inventory_json 배열이 비어있습니다.")
    }

    def hostNames = []
    parsed.eachWithIndex { host, idx ->
        def hostName = (host?.hostName ?: host?.hostname)?.toString()?.trim()
        if (!hostName) {
            error("inventory_json 항목[${idx}] 에 hostName(hostname) 이 없습니다: ${host}")
        }
        hostNames << hostName
    }
    return hostNames
}

def sendDeploymentStepForHost(String callbackUrl, String hostName, String deploymentStep) {
    def payloadPath = "deployment-step-payload-${env.BUILD_NUMBER}.json"
    def maxAttempts = 3

    for (int attempt = 1; attempt <= maxAttempts; attempt++) {
        try {
            writeJSON(file: payloadPath, json: [hostName: hostName, deploymentStep: deploymentStep])
            def response = httpRequest(
                httpMode          : 'POST',
                url               : "${callbackUrl}/api/jenkins/logical/server/deployment/step",
                contentType       : 'APPLICATION_JSON',
                requestBody       : readFile(payloadPath),
                validResponseCodes: '100:599'
            )
            def body = readJSON(text: response.content)
            if (response.status == 200 && body.success == true) {
                echo "배포단계 갱신 성공: hostName=${hostName}, deploymentStep=${deploymentStep} (attempt=${attempt}/${maxAttempts})"
                return true
            }
            echo "배포단계 갱신 실패 응답: hostName=${hostName}, attempt=${attempt}/${maxAttempts}, status=${response.status}, message=${body?.message}"
        } catch (Exception e) {
            echo "배포단계 갱신 API 호출 예외: hostName=${hostName}, attempt=${attempt}/${maxAttempts}, error=${e.message}"
        }
        if (attempt < maxAttempts) {
            sleep(time: 3, unit: 'SECONDS')
        }
    }
    return false
}

def updateDeploymentSteps(String callbackUrl, List hostNames, String deploymentStep) {
    def failedHosts = []
    hostNames.each { hostName ->
        if (!sendDeploymentStepForHost(callbackUrl, hostName, deploymentStep)) {
            failedHosts << hostName
        }
    }
    return failedHosts
}

pipeline {
    agent none

    parameters {
        string(name: 'loc',            defaultValue: 'git', description: 'Ansible 을 실행할 Jenkins Runner 라벨')
        text(  name: 'inventory_json', defaultValue: '[{"hostname":"WIN-TP7D9J9QKCB","ansible_host":"10.100.64.120"}]', description: '타겟 호스트 JSON 배열')
        string(name: 'callbackUrl',    defaultValue: '',    description: '포털 API base URL (CLOVIRONE_BASE_URL)')
    }

    stages {
        stage('Validate') {
            agent { label 'built-in' }
            steps {
                script {
                    validateParameters(params)
                }
            }
        }

        stage('Run Ansible') {
            agent { label "${params.loc}" }
            environment {
                INVENTORY_JSON = "${params.inventory_json}"
            }
            steps {
                checkout scm
                ansiblePlaybook(
                    installation: 'ansible',
                    playbook    : "${WORKSPACE}/Day2_Guide/playbook/patterns/runner-master-portal-callback/site.yml",
                    inventory   : "${WORKSPACE}/Day2_Guide/playbook/patterns/runner-master-portal-callback/inventory.sh",
                    colorized   : true
                )
            }
        }

        stage('Update Deployment Step') {
            agent { label 'built-in' }
            steps {
                script {
                    def hostNames = parseHostNames(params.inventory_json)
                    def failedHosts = updateDeploymentSteps(params.callbackUrl, hostNames, env.JOB_BASE_NAME)
                    if (failedHosts) {
                        currentBuild.result = 'UNSTABLE'
                        echo "포털 API 갱신 실패 호스트(${failedHosts.size()}/${hostNames.size()}): ${failedHosts.join(', ')}"
                    }
                }
            }
        }
    }
}
