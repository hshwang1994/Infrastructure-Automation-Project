pipeline {
    agent { label "${params.loc} && ${params.target_type}" }

    parameters {
        string(name: 'loc',         defaultValue: '', description: 'Agent 위치 (ich | chj | yi)')
        string(name: 'target_type', defaultValue: '', description: '대상 종류 (linux | windows | esxi | redfish)')
        text(  name: 'inventory_json', defaultValue: '[]', description: '타겟 호스트 JSON 배열')
    }

    environment {
        INVENTORY_JSON = "${params.inventory_json}"
        TARGET_TYPE    = "${params.target_type}"
        REPO_ROOT      = "${WORKSPACE}/Day2_Guide"
    }

    stages {
        stage('Run Ansible') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'windows-target', usernameVariable: 'WIN_USER', passwordVariable: 'WIN_PASS')]) {
                    sh '''
                        set -eu
                        mkdir -p "${REPO_ROOT}/vault"
                        umask 077
                        {
                          echo "ansible_user: ${WIN_USER}"
                          echo "ansible_password: ${WIN_PASS}"
                        } > "${REPO_ROOT}/vault/windows.yml"
                    '''
                    ansiblePlaybook(
                        installation: 'ansible',
                        playbook    : "${WORKSPACE}/Day2_Guide/playbook/tasks/windows/service-healthcheck/site.yml",
                        colorized   : true
                    )
                }
            }
        }
    }
}
